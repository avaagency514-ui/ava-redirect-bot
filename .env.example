# ava-redirect-bot — Variables d'environnement Railway

# Token du bot Telegram (@rcruting_bot)
BOT_TOKEN=VOTRE_TOKEN_TELEGRAM_ICI

# Username du bot Telegram (affichage dans les embeds Discord)
BOT_USERNAME=@rcruting_bot

# Lien de redirection Discord
DISCORD_URL=https://discord.gg/QxePAQwB3

# Texte du bouton Telegram
BUTTON_TEXT=👉 Rejoindre le QG Discord (Entretien)

# Token du bot Discord (pour notifications et rapport)
DISCORD_BOT_TOKEN=VOTRE_TOKEN_DISCORD_ICI

# ID du salon Discord où envoyer les notifications et rapports
DISCORD_LOG_CHANNEL_ID=1564832120067596318

# Notifier Discord à chaque candidat (true/false)
NOTIFY_EACH_CANDIDATE=true

# Heure du rapport journalier (format 24h, heure de Paris)
DAILY_REPORT_HOUR=23
DAILY_REPORT_MINUTE=0
